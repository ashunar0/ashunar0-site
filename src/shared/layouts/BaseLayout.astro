---
import '@/styles/global.css';
import GithubIcon from '@/shared/ui/github-icon.astro';
import Logo from '@/assets/logo.svg';
import ThemeToggle from '@/shared/layouts/theme-toggle.astro';
import Footer from '@/shared/layouts/footer.astro';

interface Props {
  title: string;
  description?: string;
  /** SNS カードの画像。サイト内の絶対パス（例: /og/hello-world.png）で渡す。 */
  image?: string;
}

const { title, description, image } = Astro.props;

/*
 * OGP のクローラは HTML を読むだけでページを実行しないため、相対パスを解決できない。
 * og:url / og:image は astro.config の site を基準にした絶対 URL にする。
 */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const navItems = [
  { href: '/posts', label: 'Posts' },
  { href: '/talks', label: 'Talks' },
];

// 現在地のナビを濃く出す。/posts/xxx でも Posts を現在地として扱う。
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      アバターを丸く抜いたもの。元が png なので svg 版は持てず、実寸を 2 つ置く。
      apple-touch-icon だけ白背景の四角にしてある。iOS はホーム画面に置くとき
      透明部分を黒で埋めるため、丸く抜いたものを渡すと角が黒くなる。
    */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    {/*
      X や Slack はここだけを読んでカードを組み立てる。
      画像を指定しても twitter:card がないと小さなサムネイル扱いになるので、
      両方を必ず組で置く。
    */}
    <meta property="og:site_name" content="ashunar0" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/*
      body が描画される前に .dark を確定させないと、暗い設定の人に白い画面が一瞬映る。
      それを防ぐため is:inline で head に直接置き、バンドルも defer もさせない。
    */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;

        document.documentElement.classList.toggle('dark', dark);

        // スクロールバーやフォーム部品など、ブラウザが描く部分も揃える
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  {/* 記事が短いページでも footer が画面下に貼りつくよう、main を伸ばす */}
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-fg antialiased">
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
        {/*
          ロゴは文字をアウトライン化した svg なので、読み上げ用に aria-label を持たせる。
          塗りは currentColor なので、テーマごとに画像を用意せず text-fg を継ぐ。
        */}
        <a
          href="/"
          aria-label="ashunar0"
          class="text-fg transition-colors hover:text-fg-soft"
        >
          <Logo class="h-6 w-auto" />
        </a>
        <div class="flex items-center gap-6">
          <nav class="flex gap-6 text-sm">
            {
              navItems.map(({ href, label }) => (
                <a
                  href={href}
                  class:list={[
                    'font-semibold transition-colors hover:text-fg',
                    isCurrent(href) ? 'text-fg' : 'text-fg-muted',
                  ]}
                >
                  {label}
                </a>
              ))
            }
          </nav>
          <ThemeToggle />
          <a
            href="https://github.com/ashunar0"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-fg-muted transition-colors hover:text-fg"
          >
            <GithubIcon class="size-5" />
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-14">
      <slot />
    </main>

    <Footer />
  </body>
</html>
