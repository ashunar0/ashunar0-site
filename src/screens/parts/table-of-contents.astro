---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// h4 以下は細かすぎるので拾わない。
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-labelledby="toc-label" class="sticky top-8">
      <p id="toc-label" class="text-xs font-semibold tracking-wider text-fg-muted uppercase">
        On This Page
      </p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-3' : undefined}>
            <a
              href={`#${heading.slug}`}
              class="text-fg transition-colors hover:text-fg"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
