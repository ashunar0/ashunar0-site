---
import { render } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import { Card } from '@/shared/ui/card';
import { Badge } from '@/shared/ui/badge';
import TableOfContents from './table-of-contents.astro';
import type { Post } from '@/features/posts/query';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const publishedOn = post.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} | ashunar0`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
>
  {/*
    直前が一覧とは限らない（検索や SNS から直接来る）ので、履歴を戻る history.back() ではなく
    行き先の決まったリンクにする。
  */}
  <a
    href="/posts"
    class="group/back mb-4 inline-flex items-center gap-1.5 text-sm text-fg-muted transition-colors hover:text-fg"
  >
    <ArrowLeft
      className="size-4 transition-transform group-hover/back:-translate-x-0.5"
      aria-hidden="true"
    />
    Posts
  </a>

  <article>
    <header class="max-w-3xl">
      <h1 class="text-2xl font-bold tracking-tight text-balance">{post.data.title}</h1>

      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-fg-muted">
        <time datetime={post.data.pubDate.toISOString()}>{publishedOn}</time>
        {
          post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true" class="text-fg-subtle">
                /
              </span>
              <ul class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li>
                    <Badge variant="subtle" size="sm" className="bg-brand-subtle text-brand-fg">
                      #{tag}
                    </Badge>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </header>

    {/* 記事ヘッダーを外に出すことで、カードと目次の上辺が揃う */}
    {/*
      items-start を付けると grid セルが目次の高さまで縮み、sticky が動く余地を失う。
      セルを行の高さ（カードの高さ）まで伸ばしたいので、既定の stretch のままにする。
    */}
    <div class="mt-8 lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-10">
      {/*
        Card.Body の padding は Card.Header が上にある前提で pt が狭い。
        本文だけを載せるここでは上下を揃えたいので、Root に直接 padding を置く。
      */}
      <Card.Root variant="outline" className="max-w-3xl p-6 sm:p-8">
        <div class="post-body">
          <Content />
        </div>
      </Card.Root>

      {/* 狭い画面では本文の幅を削ってしまうので出さない */}
      <div class="hidden lg:block">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Shiki が出す pre をラッパーで包み、右上にコピーボタンを足す。
  // クリップボードはブラウザ API なので、ここだけは静的 HTML で完結しない。
  for (const pre of document.querySelectorAll<HTMLPreElement>('.post-body pre')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = 'copy';
    wrapper.append(button);

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.textContent = 'copied';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => {
        button.textContent = 'copy';
      }, 1500);
    });
  }
</script>

{/* MDX が吐く HTML には scoped style が効かないので、.post-body に絞って global で当てる */}
<style is:global>
  .post-body {
    font-size: 0.9375rem;
    line-height: 1.9;
  }

  /* 段落やリストなど、ブロック同士の既定の間隔 */
  .post-body > * + * {
    margin-top: 1.5em;
  }

  /*
   * 見出しの margin-top は「前の本文から離す」ためのもの。先頭要素には前がないので、
   * カードの padding にそのまま上乗せされて上だけ間延びする。先頭だけ打ち消す。
   */
  .post-body > :first-child {
    margin-top: 0;
  }

  /* 見出しは上を大きく空け、直後の本文とは近づける（近いものは仲間に見える） */
  .post-body > h2 {
    position: relative;
    margin-top: 3rem;
    padding-bottom: 0.4em;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  /*
   * 見出しの装飾。縦棒（::before）と下線（::after）を同じ左端から始める。
   * 本文の左端は揃えたままにしたいので、字下げせずカードの padding 側へはみ出させる。
   *
   * 下線に border-bottom を使うと h2 の枠に沿って left: 0 から始まり、
   * 縦棒と左端が揃わないため、こちらも擬似要素で引く。
   */
  .post-body > h2::before,
  .post-body > h2::after {
    content: '';
    position: absolute;
    left: -0.75rem;
    background: var(--color-brand);
  }

  /*
   * 縦棒は下線まで伸ばさず、文字の高さに揃える。
   * line-height: 1.5 の余白が上下に 0.25em ずつ乗るのでその分を詰め、
   * 下は padding-bottom (0.4em) も足して文字の下端で止める。
   */
  .post-body > h2::before {
    top: 0.25em;
    bottom: 0.65em;
    width: 5px;
  }

  /* 半端な px は h2 の位置によって 1px / 2px に丸めが割れるので、整数で指定する */
  .post-body > h2::after {
    right: 0;
    bottom: 0;
    height: 2px;
  }

  /* 線が入ったぶん、h2 の直後だけ少し余白を足す */
  .post-body > h2 + * {
    margin-top: 1.25em;
  }

  .post-body > h3 {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > h4 {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > :is(h2, h3, h4) + * {
    margin-top: 0.75em;
  }

  .post-body a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;

    /* px 固定だと本文サイズに対して痩せて見えるので、文字に比例させる */
    text-decoration-thickness: 0.08em;
  }

  .post-body :is(ul, ol) {
    padding-left: 1.5em;
  }

  .post-body ul {
    list-style: disc;
  }

  .post-body ol {
    list-style: decimal;
  }

  .post-body li + li {
    margin-top: 0.5em;
  }

  .post-body strong {
    font-weight: 700;
  }

  /* インラインコード */
  .post-body :not(pre) > code {
    background: var(--color-surface-sunken);
    border-radius: 0.25rem;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  /*
   * コードブロック。長い行は折り返さず横スクロールさせる。
   * 背景と文字色は Shiki がインライン style で書くので、ここでは指定しない
   * （指定しても負ける）。配色を変えたいときは astro.config.mjs の shikiConfig。
   */
  .post-body pre {
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-body blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1em;
    color: var(--color-fg-muted);
  }

  .post-body :is(img, video) {
    max-width: 100%;
    border-radius: 0.5rem;
  }

  /*
   * 列が多いとカードからはみ出すので、テーブル自体を横スクロールさせる。
   * ラッパー要素は MDX が吐かないため、table に直接持たせる。
   */
  .post-body table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9333em;
    line-height: 1.7;
  }

  .post-body :is(th, td) {
    border: 1px solid var(--color-border);
    padding: 0.5em 0.75em;
    text-align: left;
    vertical-align: top;
  }

  .post-body th {
    background: var(--color-surface-sunken);
    font-weight: 600;
    white-space: nowrap;
  }

  .post-body hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }

  .post-body hr + * {
    margin-top: 3rem;
  }

  /* コピーボタン。pre 自身ではなくラッパーを基準にしないと、横スクロールで一緒に流れる */
  .post-body .code-block {
    position: relative;
  }

  .post-body .code-block > button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 0.08);
    color: #e1e4e8;
    font-size: 0.75rem;
    line-height: 1.5;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 120ms ease,
      background 120ms ease;
  }

  .post-body .code-block:hover > button,
  .post-body .code-block > button:focus-visible {
    opacity: 1;
  }

  .post-body .code-block > button:hover {
    background: rgb(255 255 255 / 0.16);
  }

  /* ホバーできない端末では出しっぱなしにする */
  @media (hover: none) {
    .post-body .code-block > button {
      opacity: 1;
    }
  }
</style>
