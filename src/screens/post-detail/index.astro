---
import { render } from 'astro:content';
import { ArrowLeft, CalendarDays, Copy } from 'lucide-react';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import { Card } from '@/shared/ui/card';
import { Badge } from '@/shared/ui/badge';
import TableOfContents from './table-of-contents.astro';
import type { Post } from '@/features/posts/query';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

/*
 * 2025.12.19 の形。toLocaleDateString('ja-JP') は 2025/12/19 と 0 詰めなしで返すため、
 * 区切りの置換だけでは桁が揃わない。en-CA が返す 0 詰めの YYYY-MM-DD を作り直す。
 */
const publishedOn = post.data.pubDate.toLocaleDateString('en-CA').replaceAll('-', '.');

/*
 * 記事ヘッダーと本文カードは別の要素だが、右端は揃えたい。
 * カードは目次と並ぶ grid の 1 列目に入るため max-w-3xl まで伸びきらず、
 * ヘッダーに max-w-3xl を直接置くと目次のぶん（13rem + gap）だけ右にはみ出す。
 * 同じ grid を被せて列幅そのものを共有する。
 */
const contentGrid = 'lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-10';
---

<BaseLayout
  title={`${post.data.title} | ashunar0`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
>
  {/*
    直前が一覧とは限らない（検索や SNS から直接来る）ので、履歴を戻る history.back() ではなく
    行き先の決まったリンクにする。
  */}
  <a
    href="/posts"
    class="group/back mb-4 inline-flex items-center gap-1.5 text-sm text-fg-muted transition-colors hover:text-fg"
  >
    <ArrowLeft
      className="size-4 transition-transform group-hover/back:-translate-x-0.5"
      aria-hidden="true"
    />
    Posts
  </a>

  <article>
    <div class={contentGrid}>
      <header class="max-w-3xl">
        <h1 class="text-2xl font-bold tracking-tight text-balance">{post.data.title}</h1>

        {/*
          タグが増えて折り返しても、ボタンは右端に留めたいので行を分けて持つ。
          狭い画面では日付とタグに幅を譲りたいので、横並びをやめて下に積む。
        */}
        <div
          class="mt-5 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-fg-muted">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="inline-flex items-center gap-1.5"
            >
              <CalendarDays className="size-3.5 text-fg-subtle" aria-hidden="true" />
              {publishedOn}
            </time>
            {
              post.data.tags.length > 0 && (
                <>
                  <span aria-hidden="true" class="text-fg-subtle">
                    /
                  </span>
                  <ul class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <li>
                        <Badge variant="subtle" size="sm" className="bg-brand-subtle text-brand-fg">
                          #{tag}
                        </Badge>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }
          </div>

          {/*
            押した結果を文字で返したいので、aria-live で読み上げにも伝える。
            幅が Copied で変わると右端がガタつくため、ラベルの最小幅を決めておく。
          */}
          <button
            type="button"
            data-copy-markdown={`/posts/${post.id}.md`}
            class="cursor-pointer inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md border border-border bg-surface px-2 text-xs text-fg-muted transition-colors hover:bg-surface-sunken hover:text-fg"
          >
            <Copy className="size-3.5" aria-hidden="true" />
            <span class="min-w-[6.5em] text-left" aria-live="polite">Copy Markdown</span>
          </button>
        </div>
      </header>
    </div>

    {/* 記事ヘッダーを外に出すことで、カードと目次の上辺が揃う */}
    {/*
      items-start を付けると grid セルが目次の高さまで縮み、sticky が動く余地を失う。
      セルを行の高さ（カードの高さ）まで伸ばしたいので、既定の stretch のままにする。
    */}
    <div class="mt-8 lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-10">
      {/*
        Card.Body の padding は Card.Header が上にある前提で pt が狭い。
        本文だけを載せるここでは上下を揃えたいので、Root に直接 padding を置く。
      */}
      <Card.Root variant="outline" className="max-w-3xl p-6 sm:p-8">
        <div class="post-body">
          <Content />
        </div>
      </Card.Root>

      {/* 狭い画面では本文の幅を削ってしまうので出さない */}
      <div class="hidden lg:block">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // widgets.js が実行時に生やすもの。型は付いてこないのでここで宣言する。
  declare global {
    interface Window {
      twttr?: { widgets: { load: (target?: HTMLElement) => void } };
    }
  }

  // 生 markdown を取りにいってクリップボードへ。本文を HTML に二重に持たせずに済む。
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-markdown]');

  if (copyButton) {
    const label = copyButton.querySelector('span')!;

    copyButton.addEventListener('click', async () => {
      try {
        const response = await fetch(copyButton.dataset.copyMarkdown!);
        if (!response.ok) throw new Error(String(response.status));

        await navigator.clipboard.writeText(await response.text());
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Failed';
      }

      setTimeout(() => {
        label.textContent = 'Copy Markdown';
      }, 1500);
    });
  }

  /*
   * X の投稿を埋め込む。remark-link-card が置いた .tweet-embed を widgets.js が iframe に差し替える。
   * 投稿がある記事でだけスクリプトを足したいので、読み込みはここで行う。
   */
  const tweets = [...document.querySelectorAll<HTMLElement>('.tweet-embed')];

  if (tweets.length > 0) {
    const currentTheme = () =>
      document.documentElement.classList.contains('dark') ? 'dark' : 'light';

    /*
     * 配色は blockquote の data-theme を見て iframe が組まれるため、
     * 出来上がったあとから変えられない。テーマを変えたら中身ごと作り直す。
     */
    const paint = () => {
      const theme = currentTheme();

      for (const wrapper of tweets) {
        const quote = document.createElement('blockquote');
        quote.className = 'twitter-tweet';
        quote.dataset.theme = theme;

        // 既定の 550px は本文の中で目立ちすぎる。250〜550 の範囲で指定でき、中身は組み直される。
        quote.dataset.width = '500';

        // 中身のないリンクを置くと、widgets.js が投稿を取ってきて描き換える
        const link = document.createElement('a');
        link.href = wrapper.dataset.tweetUrl!;
        quote.append(link);

        wrapper.replaceChildren(quote);
      }

      window.twttr?.widgets.load();
    };

    paint();

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://platform.twitter.com/widgets.js';
    document.head.append(script);

    // テーマの切り替えは html の class で伝わる。トグル側に手を入れずに拾う。
    let theme = currentTheme();

    new MutationObserver(() => {
      if (currentTheme() === theme) return;
      theme = currentTheme();
      paint();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  // Shiki が出す pre をラッパーで包み、右上にコピーボタンを足す。
  // クリップボードはブラウザ API なので、ここだけは静的 HTML で完結しない。
  for (const pre of document.querySelectorAll<HTMLPreElement>('.post-body pre')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = 'copy';
    wrapper.append(button);

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.textContent = 'copied';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => {
        button.textContent = 'copy';
      }, 1500);
    });
  }
</script>

{/* MDX が吐く HTML には scoped style が効かないので、.post-body に絞って global で当てる */}
{/*
  ここを変えたら docs/markdown-preview.css も合わせること。
  あちらは VSCode の Markdown プレビューを公開後の見た目に寄せるための写しで、
  .post-body を body に読み替えたものを二重管理している（詳細は AGENTS.md）。
*/}
<style is:global>
  .post-body {
    font-size: 0.9375rem;
    line-height: 1.9;
  }

  /* 段落やリストなど、ブロック同士の既定の間隔 */
  .post-body > * + * {
    margin-top: 1.5em;
  }

  /*
   * 見出しの margin-top は「前の本文から離す」ためのもの。先頭要素には前がないので、
   * カードの padding にそのまま上乗せされて上だけ間延びする。先頭だけ打ち消す。
   */
  .post-body > :first-child {
    margin-top: 0;
  }

  /* 見出しは上を大きく空け、直後の本文とは近づける（近いものは仲間に見える） */
  .post-body > h2 {
    position: relative;
    margin-top: 3rem;
    padding-bottom: 0.4em;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  /*
   * 見出しの装飾。縦棒（::before）と下線（::after）を同じ左端から始める。
   * 本文の左端は揃えたままにしたいので、字下げせずカードの padding 側へはみ出させる。
   *
   * 下線に border-bottom を使うと h2 の枠に沿って left: 0 から始まり、
   * 縦棒と左端が揃わないため、こちらも擬似要素で引く。
   */
  .post-body > h2::before,
  .post-body > h2::after {
    content: '';
    position: absolute;
    left: -0.75rem;
    background: var(--color-brand);
  }

  /*
   * 縦棒は下線まで伸ばさず、文字の高さに揃える。
   * line-height: 1.5 の余白が上下に 0.25em ずつ乗るのでその分を詰め、
   * 下は padding-bottom (0.4em) も足して文字の下端で止める。
   */
  .post-body > h2::before {
    top: 0.25em;
    bottom: 0.65em;
    width: 5px;
  }

  /* 半端な px は h2 の位置によって 1px / 2px に丸めが割れるので、整数で指定する */
  .post-body > h2::after {
    right: 0;
    bottom: 0;
    height: 2px;
  }

  /* 線が入ったぶん、h2 の直後だけ少し余白を足す */
  .post-body > h2 + * {
    margin-top: 1.25em;
  }

  .post-body > h3 {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > h4 {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > :is(h2, h3, h4) + * {
    margin-top: 0.75em;
  }

  .post-body a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;

    /* px 固定だと本文サイズに対して痩せて見えるので、文字に比例させる */
    text-decoration-thickness: 0.08em;
  }

  .post-body :is(ul, ol) {
    padding-left: 1.5em;
  }

  .post-body ul {
    list-style: disc;
  }

  .post-body ol {
    list-style: decimal;
  }

  .post-body li + li {
    margin-top: 0.5em;
  }

  .post-body strong {
    font-weight: 700;
  }

  /* インラインコード */
  .post-body :not(pre) > code {
    background: var(--color-surface-sunken);
    border-radius: 0.25rem;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  /*
   * コードブロック。長い行は折り返さず横スクロールさせる。
   * 背景と文字色は Shiki がインライン style で書くので、ここでは指定しない
   * （指定しても負ける）。配色を変えたいときは astro.config.mjs の shikiConfig。
   */
  .post-body pre {
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /*
   * リンクカード。remark-link-card が出す HTML に当てる。
   * 本文中の a は下線付きの色文字なので、カードだけそれを打ち消す。
   */
  /*
   * 高さは固定する。中身は相手のサイト任せで、説明文の有無も OG 画像の縦横比もばらばらなため、
   * 成り行きに任せると並べたときに高さが揃わない（正方形の OG 画像を持つサイトが特に伸びる）。
   * 入りきらない分は行数で切る。
   */
  .post-body .link-card {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
    height: 8.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease;
  }

  .post-body .link-card:hover {
    background: var(--color-surface-sunken);
  }

  .post-body .link-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.875rem 1rem;
  }

  /*
   * 長いタイトルでカードが伸びると一覧性が落ちるので、2 行で切る。
   * line-clamp は「2 行で切る」だけで高さは確保しないため、flex の既定の縮みに任せると
   * 2 行ぶんの場所を貰えず 2 行目が途中で欠ける。縮まないようにして高さを守る。
   */
  .post-body .link-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    flex-shrink: 0;
    overflow: hidden;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  /* 高さが決まっているぶん、説明は 1 行に抑えないとホスト名を押し出す */
  .post-body .link-card__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    flex-shrink: 0;
    overflow: hidden;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  /*
   * ホスト名はカードの下端に置く。margin-top: auto が縦の余りを吸う。
   * 段落の余白は .post-body > * + * が直接の子だけに当たるものなので、ここには届かない。
   */
  .post-body .link-card__host {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.25rem;
    color: var(--color-fg-muted);
    font-size: 0.75rem;
  }

  .post-body .link-card__host img {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 0.125rem;
  }

  /* 幅は固定、高さはテキスト側に合わせる。潰れないよう縮小を止める */
  .post-body .link-card__image {
    flex-shrink: 0;
    width: 10rem;
  }

  .post-body .link-card__image img {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  /* 横幅が足りない画面では、サムネイルを落として文字だけにする */
  @media (max-width: 30rem) {
    .post-body .link-card__image {
      display: none;
    }
  }

  .post-body blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1em;
    color: var(--color-fg-muted);
  }

  /*
   * X の投稿。差し替わったあとの見た目は向こうの iframe が持つので、こちらは場所だけ決める。
   * 器は本文の幅いっぱいに取り、中の iframe を中央に置く（幅は data-width で決まる）。
   */
  .post-body .tweet-embed {
    /* 差し替わるまでは中身が 1 行のリンクなので、その分だけ本文が下にずれる。
       いちばん小さい投稿くらいの高さを先に確保して、ずれ幅を減らす。 */
    min-height: 12rem;
  }

  /* 引用の見た目は本文の blockquote 用のもの。埋め込み待ちのリンクには要らない */
  .post-body .tweet-embed blockquote {
    border-left: 0;
    padding-left: 0;
    margin: 0;
  }

  /*
   * widgets.js は blockquote を div.twitter-tweet-rendered に置き換え、その中に iframe を入れる。
   * 幅を持っているのはこの div なので、中央寄せはここに効かせる（iframe 側に書いても届かない）。
   * 向こうの margin: 10px 0 を上書きするため !important が要る。
   */
  .post-body .tweet-embed .twitter-tweet-rendered {
    margin-inline: auto !important;
  }

  .post-body .tweet-embed iframe {

    /*
     * 角を丸めているのは iframe の中の投稿カードで、iframe 自身の下地は白のまま。
     * 暗いテーマだと丸めた外側の四隅にその白が覗くので、iframe 自体を同じ丸みで切り抜く。
     *
     * 器（.tweet-embed）側に付けても届かない。widgets.js が iframe を上下 10px 空けて置くため、
     * 切り抜き線が iframe の角から離れてしまう。
     */
    border-radius: 12px;
  }

  .post-body :is(img, video) {
    max-width: 100%;
    border-radius: 0.5rem;
  }

  /*
   * 列が多いとカードからはみ出すので、テーブル自体を横スクロールさせる。
   * ラッパー要素は MDX が吐かないため、table に直接持たせる。
   */
  .post-body table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9333em;
    line-height: 1.7;
  }

  .post-body :is(th, td) {
    border: 1px solid var(--color-border);
    padding: 0.5em 0.75em;
    text-align: left;
    vertical-align: top;
  }

  .post-body th {
    background: var(--color-surface-sunken);
    font-weight: 600;
    white-space: nowrap;
  }

  .post-body hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }

  .post-body hr + * {
    margin-top: 3rem;
  }

  /* コピーボタン。pre 自身ではなくラッパーを基準にしないと、横スクロールで一緒に流れる */
  .post-body .code-block {
    position: relative;
  }

  .post-body .code-block > button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 0.08);
    color: #e1e4e8;
    font-size: 0.75rem;
    line-height: 1.5;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 120ms ease,
      background 120ms ease;
  }

  .post-body .code-block:hover > button,
  .post-body .code-block > button:focus-visible {
    opacity: 1;
  }

  .post-body .code-block > button:hover {
    background: rgb(255 255 255 / 0.16);
  }

  /* ホバーできない端末では出しっぱなしにする */
  @media (hover: none) {
    .post-body .code-block > button {
      opacity: 1;
    }
  }
</style>
