---
import { Badge } from '@/shared/ui/badge';
import type { Post } from '@/features/posts/query';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const date = post.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

{/* 最新の一本。ここだけ説明文まで出して「まずこれを読んで」を示す */}
<a href={`/posts/${post.id}`} class="group/featured block">
  <time datetime={post.data.pubDate.toISOString()} class="text-sm text-fg-muted tabular-nums">
    {date}
  </time>

  <h3 class="mt-1 text-xl font-bold tracking-tight transition-colors group-hover/featured:text-brand">
    {post.data.title}
  </h3>

  {/* 幅いっぱいだと一行が長くなりすぎて読みづらいので、説明文だけ measure を切る */}
  <p class="mt-2 max-w-2xl line-clamp-2 text-sm leading-relaxed text-fg-muted">
    {post.data.description}
  </p>

  {
    post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <li>
            <Badge variant="subtle" size="sm" className="bg-brand-subtle text-brand-fg">
              #{tag}
            </Badge>
          </li>
        ))}
      </ul>
    )
  }
</a>
