---
import { ChevronLeft, ChevronRight, Pause, Play, X } from 'lucide-react';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import Story from './story.astro';
import EndSlide from './end-slide.astro';
import QuickSlide from './quick-slide.astro';
import { formatNewsDate, getNewsList, type News } from '@/features/news/query';

interface Props {
  news: News;
}

const { news } = Astro.props;
const date = formatNewsDate(news.pubDate);
const { stories, quick } = news.data;

// 進み具合のバーは読むもの（記事と短信）の枚数だけ持つ。最後の 1 枚は数えない
const segmentCount = stories.length + (quick.length > 0 ? 1 : 0);

// 最後の 1 枚から前後の日へ渡すため。一覧は新しい順なので、後ろが古い日
const list = await getNewsList();
const position = list.findIndex((item) => item.id === news.id);
const newer = list[position - 1];
const older = list[position + 1];
---

{/*
  インスタのストーリーズを下敷きにした画面。サイトのヘッダーとフッターは出さず、
  1 本ずつめくって読む。スマホでは画面いっぱい、広い画面では縦長の枠を中央に置く。
*/}
<BaseLayout
  title={`News ${date} | ashunar0`}
  description={`${date} のニュース`}
  image={`/og/news/${news.id}.png`}
  bare
>
  <div class="flex h-dvh items-center justify-center gap-4 sm:bg-stone-950 sm:p-4">
    {/* 広い画面ではめくる操作を枠の外に出す。スマホでは枠の中のタップで代わる */}
    <button
      type="button"
      data-prev
      aria-label="前のニュース"
      class="hidden size-10 shrink-0 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 disabled:invisible sm:flex"
    >
      <ChevronLeft className="size-5" aria-hidden="true" />
    </button>

    <div
      class="relative flex h-full w-full flex-col bg-surface sm:aspect-[9/16] sm:w-auto sm:max-w-full sm:overflow-hidden sm:rounded-xl"
    >
      <div data-header class="flex flex-col gap-3 px-4 pt-3 pb-2">
        <ol class="flex gap-1" aria-hidden="true">
          {Array.from({ length: segmentCount }, () => (
            <li class="h-0.5 flex-1 overflow-hidden rounded-full bg-border">
              {/* 自動再生の進み具合をここの幅で見せる。幅はスクリプトが動かす */}
              <div data-segment class="h-full w-0 bg-fg" />
            </li>
          ))}
        </ol>

        <div class="flex items-center justify-between">
          <div class="flex items-baseline gap-2 text-sm">
            <span class="font-semibold">News</span>
            <time datetime={news.pubDate.toISOString()} class="text-fg-muted">{date}</time>
          </div>

          <div class="-mr-2 flex items-center">
            {/* 自動再生の入り切り。押すと何が起きるかを絵で示すので、再生中は一時停止の絵を出す */}
            <button
              type="button"
              data-autoplay
              aria-pressed="true"
              aria-label="自動再生"
              class="flex size-9 cursor-pointer items-center justify-center rounded-full text-fg-muted transition-colors hover:bg-hover hover:text-fg"
            >
              <Pause data-autoplay-on className="size-4" aria-hidden="true" />
              <Play data-autoplay-off className="hidden size-4" aria-hidden="true" />
            </button>

            {/* 直前が一覧とは限らない（X から直接来る）ので、履歴を戻らず一覧へのリンクにする */}
            <a
              href="/news"
              aria-label="閉じる"
              class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors hover:bg-hover hover:text-fg"
            >
              <X className="size-5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      {/*
        中身が収まらないときは、ストーリーの中で縦にスクロールして読む。
        左 1/3 のタップで戻り、残りで進む（リンクや埋め込みの上は除く）。
      */}
      <div data-scroller class="min-h-0 flex-1 overflow-y-auto">
        {
          stories.map((story, index) => (
            <div data-story hidden={index !== 0} class="px-5 pt-4 pb-10">
              <Story story={story} />
            </div>
          ))
        }

        {
          quick.length > 0 && (
            <div data-story hidden class="px-5 pt-4 pb-10">
              <QuickSlide quick={quick} />
            </div>
          )
        }

        {/*
          進み具合のバーは記事と短信の枚数だけ持つ。ここに来たときは全部が塗られた状態になる。
          写真を枠いっぱいに敷くので、余白は記事の側にだけ持たせている。
        */}
        <div data-story hidden class="h-full">
          <EndSlide news={news} older={older} newer={newer} />
        </div>
      </div>

      {/*
        スマホでめくるためのボタン。X の埋め込みの上はタップが iframe に吸われてページに届かず、
        埋め込みが画面の大半を占めると押せる場所がなくなるため、中身とは別の帯に置く。
        広い画面では枠の外の矢印が同じ役目を持つので出さない。
      */}
      {/*
        スマホでめくるための矢印。X の埋め込みの上はタップが iframe に吸われてページに届かず、
        埋め込みが画面の大半を占めると押せる場所がなくなるため、中身の上に重ねて必ず押せるようにする。
        半透明にして、下の文字や投稿が透けるようにしてある。
        広い画面では枠の外の矢印が同じ役目を持つので出さない。
      */}
      <button
        type="button"
        data-prev
        data-side
        aria-label="前のニュース"
        class="absolute top-1/2 left-2 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/35 text-white backdrop-blur-sm transition-opacity disabled:invisible sm:hidden"
      >
        <ChevronLeft className="size-5" aria-hidden="true" />
      </button>
      <button
        type="button"
        data-next
        data-side
        aria-label="次のニュース"
        class="absolute top-1/2 right-2 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/35 text-white backdrop-blur-sm transition-opacity disabled:invisible sm:hidden"
      >
        <ChevronRight className="size-5" aria-hidden="true" />
      </button>
    </div>

    <button
      type="button"
      data-next
      aria-label="次のニュース"
      class="hidden size-10 shrink-0 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 disabled:invisible sm:flex"
    >
      <ChevronRight className="size-5" aria-hidden="true" />
    </button>
  </div>
</BaseLayout>

<script>
  import { mountTweets } from '@/features/embeds/mount-tweets';

  const stories = [...document.querySelectorAll<HTMLElement>('[data-story]')];
  const segments = [...document.querySelectorAll<HTMLElement>('[data-segment]')];
  const scroller = document.querySelector<HTMLElement>('[data-scroller]')!;
  // めくるボタンは、広い画面の枠の外の矢印と、スマホの枠の中の矢印の 2 組ある
  const prevButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-prev]')];
  const nextButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-next]')];
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const sideButtons = [...document.querySelectorAll<HTMLElement>('[data-side]')];
  const autoplayButton = document.querySelector<HTMLButtonElement>('[data-autoplay]')!;

  /*
   * 自動再生。1 枚 20 秒でバーが伸び切ったら次へ進む。
   * 読んでいる途中で勝手に進むのがいちばん嫌なので、その 1 枚の中でスクロールやタップ、
   * 埋め込みの操作をしたら、その 1 枚のあいだは止める。次の 1 枚に移ればまた動く。
   * 入り切りは × の左のボタンで、選んだ側を覚えておく。動きを減らす設定の人は既定で切る。
   */
  const DURATION = 20_000;
  const STORAGE_KEY = 'news-autoplay';

  const loadAutoplay = () => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return stored === 'on';
    } catch {
      // 保存が使えない環境でも、既定値で動けばよい
    }
    return !matchMedia('(prefers-reduced-motion: reduce)').matches;
  };

  let autoplay = loadAutoplay();
  let held = false; // この 1 枚で触られたので止めている
  let elapsed = 0;

  let current = 0;

  const running = () => autoplay && !held && current < segments.length;

  // 読み終えたぶんは満たし、今の 1 枚は自動再生で進んだぶんだけ伸ばす。止まっているときは満たしておく
  const paintSegments = () => {
    segments.forEach((segment, i) => {
      const ratio = i < current ? 1 : i > current ? 0 : running() ? elapsed / DURATION : 1;
      segment.style.width = `${ratio * 100}%`;
    });
  };

  const hold = () => {
    if (held) return;
    held = true;
    paintSegments();
  };

  // remember は押されたときだけ。開いただけで既定値を書き込むと、OS の設定を変えても追従しなくなる
  const setAutoplay = (on: boolean, remember = true) => {
    autoplay = on;
    held = false;
    autoplayButton.setAttribute('aria-pressed', String(on));
    autoplayButton.querySelector('[data-autoplay-on]')!.classList.toggle('hidden', !on);
    autoplayButton.querySelector('[data-autoplay-off]')!.classList.toggle('hidden', on);
    if (remember) {
      try {
        localStorage.setItem(STORAGE_KEY, on ? 'on' : 'off');
      } catch {
        // 覚えられないだけで、この場の入り切りは効く
      }
    }
    paintSegments();
  };

  const show = (index: number) => {
    if (index < 0 || index >= stories.length) return;
    current = index;

    stories.forEach((story, i) => (story.hidden = i !== current));

    // 最後の 1 枚は写真を枠いっぱいに見せる。上の帯の日付や閉じるも、左右の矢印も出さない。
    // その中にあるもの（一覧へ・最初から）と左側のタップで足りる
    const isEnd = current === stories.length - 1;
    header.hidden = isEnd;
    for (const button of sideButtons) button.hidden = isEnd;

    elapsed = 0;
    held = false;
    paintSegments();

    for (const button of prevButtons) button.disabled = current === 0;
    for (const button of nextButtons) button.disabled = isEnd;

    scroller.scrollTop = 0;
  };

  for (const button of prevButtons) button.addEventListener('click', () => show(current - 1));
  for (const button of nextButtons) button.addEventListener('click', () => show(current + 1));
  document.querySelector('[data-restart]')?.addEventListener('click', () => show(0));

  scroller.addEventListener('click', (event) => {
    // リンクを押したとき、文字を選んだときはめくらない
    if ((event.target as HTMLElement).closest('a, button')) return;
    if (!document.getSelection()?.isCollapsed) return;

    const { left, width } = scroller.getBoundingClientRect();
    show(event.clientX - left < width / 3 ? current - 1 : current + 1);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  autoplayButton.addEventListener('click', () => setAutoplay(!autoplay));

  // 読もうとした合図。タップでめくった場合は、このあと show() が新しい 1 枚で止めを外す
  scroller.addEventListener('pointerdown', hold);
  scroller.addEventListener('wheel', hold, { passive: true });
  scroller.addEventListener('touchstart', hold, { passive: true });

  // 埋め込み（iframe）の中の操作はページに届かない。iframe にフォーカスが移ったことで拾う
  window.addEventListener('blur', () => {
    if (document.activeElement instanceof HTMLIFrameElement) hold();
  });

  let last = performance.now();
  const tick = (now: number) => {
    // 裏のタブから戻ったときに、離れていたぶんを一度に進めない
    const delta = Math.min(now - last, 100);
    last = now;

    if (running() && !document.hidden) {
      elapsed += delta;
      if (elapsed >= DURATION) show(current + 1);
      else paintSegments();
    }
    requestAnimationFrame(tick);
  };

  setAutoplay(autoplay, false);
  show(0);
  requestAnimationFrame(tick);
  mountTweets([...document.querySelectorAll<HTMLElement>('.tweet-embed')]);
</script>
