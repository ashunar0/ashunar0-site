---
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import PostYearGroup from './post-year-group.astro';
import ProfileCard from './profile-card.astro';
import { getPublishedPosts, type Post } from '@/features/posts/query';

const posts = await getPublishedPosts();

// 新しい順に並んだ配列をそのまま畳むので、年も年内の記事も新しい順のまま保たれる。
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="Posts | ashunar0" description="書いた記事の一覧">
  {/* 見出しに # を付ける表記は home の「# Recent posts」と揃える */}
  <h1 class="max-w-3xl font-semibold tracking-wider text-fg text-lg"># Posts</h1>

  {/*
    詳細ページの目次と同じ列幅・同じ間隔にして、右のレールの位置を揃える。
    狭い画面では本文の幅を削ってしまうので出さない。
  */}
  <div class="mt-8 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-6">
    {
      posts.length === 0 ? (
        <p class="text-sm text-fg-muted">まだ記事がない。</p>
      ) : (
        <div class="flex max-w-3xl flex-col gap-6">
          {/* 最新の年だけ開いておき、古い年は畳んで一覧の見通しを保つ */}
          {[...byYear].map(([year, yearPosts], index) => (
            <PostYearGroup year={year} posts={yearPosts} open={index === 0} />
          ))}
        </div>
      )
    }

    <div class="hidden lg:block">
      <div class="sticky top-8">
        <ProfileCard />
      </div>
    </div>
  </div>
</BaseLayout>
