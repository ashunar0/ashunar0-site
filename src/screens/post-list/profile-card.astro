---
import { Image } from 'astro:assets';
import { Card } from '@/shared/ui/card';
import GithubIcon from '@/shared/ui/github-icon.astro';
import avatar from '@/assets/avatar.png';
import avatarDark from '@/assets/avatar-dark.png';

// TODO: role と bio はあさひが書く。
const name = 'asahi';
const handle = 'ashunar0';
const bio = 'エンジニア。大学4年生。大学生になって初めてプログラミングに触れて、Unity, React, Honoなどを勉強。フルスタックエンジニアになれるように修行中。ヨルシカが好き。';
---

<Card.Root variant="outline" className="p-5">
  {/* 縦積みを一段減らすため、アバターと名前は横に並べる */}
  <div class="flex items-center gap-3">
    {/*
      画像の地が塗りつぶしなので、テーマごとに用意した 2 枚を class で出し分ける。
      prefers-color-scheme のメディアクエリでは切り替えボタンの選択に追従できない。

      alt は空にする。すぐ横に名前がテキストであるので、読み上げると二重になる。
      src/assets に置いた画像は astro:assets がビルド時にリサイズして webp にする。
      表示は 56px だが Retina を考えて 2 倍で書き出す。
    */}
    <Image
      src={avatar}
      alt=""
      width={112}
      height={112}
      class="size-14 shrink-0 rounded-full border border-border object-cover dark:hidden"
    />
    <Image
      src={avatarDark}
      alt=""
      width={112}
      height={112}
      class="hidden size-14 shrink-0 rounded-full border border-border object-cover dark:block"
    />

    <div class="min-w-0">
      <p class="truncate font-semibold">{name}</p>
      <p class="truncate text-sm text-fg-muted">@{handle}</p>
    </div>
  </div>

  <p class="mt-4 text-sm text-fg-soft">{bio}</p>

  <div class="mt-4 flex items-center gap-3">
    <a
      href={`https://github.com/${handle}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="text-fg-muted transition-colors hover:text-fg"
    >
      <GithubIcon class="size-5" />
    </a>

    <a href="/about" class="ml-auto text-sm text-fg-muted transition-colors hover:text-brand">
      About
    </a>
  </div>
</Card.Root>
