---
import { render } from 'astro:content';
import BaseLayout from '@/shared/layouts/BaseLayout.astro';
import { Card } from '@/shared/ui/card';
import { Badge } from '@/shared/ui/badge';
import type { Post } from '@/features/posts/query';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedOn = post.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | ashunar0`} description={post.data.description}>
  <article class="max-w-3xl">
    <header>
      <h1 class="text-2xl font-bold tracking-tight text-balance">{post.data.title}</h1>

      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-fg-muted">
        <time datetime={post.data.pubDate.toISOString()}>{publishedOn}</time>
        {
          post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true" class="text-fg-subtle">
                /
              </span>
              <ul class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li>
                    <Badge variant="subtle" colorPalette="info" size="sm">
                      #{tag}
                    </Badge>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </header>

    {/*
      Card.Body の padding は Card.Header が上にある前提で pt が狭い。
      本文だけを載せるここでは上下を揃えたいので、Root に直接 padding を置く。
    */}
    <Card.Root variant="outline" className="mt-8 p-6 sm:p-8">
      <div class="post-body">
        <Content />
      </div>
    </Card.Root>
  </article>
</BaseLayout>

{/* MDX が吐く HTML には scoped style が効かないので、.post-body に絞って global で当てる */}
<style is:global>
  .post-body {
    font-size: 0.9375rem;
    line-height: 1.9;
  }

  /* 段落やリストなど、ブロック同士の既定の間隔 */
  .post-body > * + * {
    margin-top: 1.5em;
  }

  /* 見出しは上を大きく空け、直後の本文とは近づける（近いものは仲間に見える） */
  .post-body > h2 {
    margin-top: 3rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .post-body > h3 {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > h4 {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .post-body > :is(h2, h3, h4) + * {
    margin-top: 0.75em;
  }

  .post-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .post-body :is(ul, ol) {
    padding-left: 1.5em;
  }

  .post-body ul {
    list-style: disc;
  }

  .post-body ol {
    list-style: decimal;
  }

  .post-body li + li {
    margin-top: 0.5em;
  }

  .post-body strong {
    font-weight: 700;
  }

  /* インラインコード */
  .post-body :not(pre) > code {
    background: var(--color-surface-sunken);
    border-radius: 0.25rem;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  /* コードブロック。長い行は折り返さず横スクロールさせる */
  .post-body pre {
    background: var(--color-surface-sunken);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-body blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1em;
    color: var(--color-fg-muted);
  }

  .post-body :is(img, video) {
    max-width: 100%;
    border-radius: 0.5rem;
  }

  /*
   * 列が多いとカードからはみ出すので、テーブル自体を横スクロールさせる。
   * ラッパー要素は MDX が吐かないため、table に直接持たせる。
   */
  .post-body table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    line-height: 1.7;
  }

  .post-body :is(th, td) {
    border: 1px solid var(--color-border);
    padding: 0.5em 0.75em;
    text-align: left;
    vertical-align: top;
  }

  .post-body th {
    background: var(--color-surface-sunken);
    font-weight: 600;
    white-space: nowrap;
  }

  .post-body hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
  }

  .post-body hr + * {
    margin-top: 3rem;
  }
</style>
