---
import type { GetStaticPaths } from 'astro';
import { getPublishedPosts, type Post } from '@/features/posts/query';
import PostDetail from '@/screens/post-detail/index.astro';

// URL の生成はルーティングの責務なので pages に置く。画面の中身は screens が持つ。
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

// getStaticPaths の props は Astro.props に型が伝わらないので、ここで明示する。
interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<PostDetail post={post} />
