---
import '../styles/global.css';
import GithubIcon from '../components/github-icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const navItems = [
  { href: '/posts', label: 'Posts' },
  { href: '/about', label: 'About' },
];

// 現在地のナビを濃く出す。/posts/xxx でも Posts を現在地として扱う。
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="bg-bg font-sans text-fg antialiased">
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
        <a href="/" class="text-xl font-bold tracking-tight transition-colors hover:text-fg-soft">
          @ashunar0
        </a>
        <div class="flex items-center gap-6">
          <nav class="flex gap-6 text-sm">
            {
              navItems.map(({ href, label }) => (
                <a
                  href={href}
                  class:list={[
                    'font-semibold transition-colors hover:text-fg',
                    isCurrent(href) ? 'text-fg' : 'text-fg-muted',
                  ]}
                >
                  {label}
                </a>
              ))
            }
          </nav>
          <a
            href="https://github.com/ashunar0"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-fg-muted transition-colors hover:text-fg"
          >
            <GithubIcon class="size-5" />
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-14">
      <slot />
    </main>
  </body>
</html>
